{
    "rewrites": [
        { "source": "/order/success", "destination": "/" },
        { "source": "/(.*)", "destination": "/" }
    ],
    "env": {
        "VITE_BACKEND_URL": "https://urbanhub-90b4.onrender.com"
    },
    "builds": [
    {
      "src": "package.json",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}